{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app:api",
                "--reload",
                "--host=0.0.0.0",
                "--port=35555"
            ],
            "jinja": true,
            "justMyCode": false,
            "cwd": "${workspaceFolder}/slackbot_jsl"
        },
        {
            "name": "wk1 Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
        }
    ]
}